BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=HashBeeBot
WEBHOOK_URL=https://your-render-app.onrender.com
WEBHOOK_SECRET=your_webhook_secret_here

DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres
REDIS_URL=rediss://default:password@your-upstash-redis.upstash.io:6379

JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
ADMIN_JWT_SECRET=your_admin_jwt_secret_here

PORT=8080
ENV=development

# Telegram WebApp validation
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Admin panel
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD_HASH=bcrypt_hash_here

# Rate limiting
RATE_LIMIT_RPS=20

# Feature flags (true/false)
FEATURE_PAID_PACKS=false
FEATURE_CAMPAIGNS=true
FEATURE_ADMIN_CAMPAIGN_APPROVAL=false
FEATURE_ANTI_CHEAT_LEAVE_PENALTY=false
FEATURE_MANUAL_WITHDRAWAL_REVIEW=true

# Economy defaults (can also be set in DB settings table)
DEFAULT_HIVE_CAP_HOURS=8
DEFAULT_BASE_BP=1
DEFAULT_WELCOME_BONUS_BP=2
DEFAULT_REFERRAL_L1_BP=5
DEFAULT_REFERRAL_L2_BP=2
DEFAULT_REFERRAL_L3_BP=1
DEFAULT_MIN_WITHDRAWAL_USDT=0.05
DEFAULT_CAMPAIGN_PRICE_PER_COMPLETION=0.001
DEFAULT_HONEY_PER_BP_PER_HOUR=0.001
DEFAULT_REINVEST_RATE=100

# Crypto / payment
PAYMENT_WALLET_USDT_TRC20=your_trc20_wallet_address
PAYMENT_WALLET_TON=your_ton_wallet_address

# Notifications
NOTIFY_HIVE_FULL=true
NOTIFY_HIVE_FULL_COOLDOWN_HOURS=12
